# Postgres/TimescaleDB connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/papercoin

# Signs session JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com — create a Web application OAuth client,
# add {NEXT_PUBLIC_APP_URL}/api/auth/google/callback as an authorized redirect URI)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Standalone snapshot-replay server — order-book visual during backtests only
NEXT_PUBLIC_BACKTEST_WS_URL=ws://localhost:8080
